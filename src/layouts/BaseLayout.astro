---
// Template base de todas as páginas: SEO, Open Graph, JSON-LD e landmarks.
// Único ponto que importa o CSS global (inline no build: sem requisição render-blocking).
import '../styles/global.css';
import fontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Caminho relativo a `public/`, sem barra inicial. */
  ogImage?: string;
  ogImageAlt?: string;
  /** `true` em páginas que não devem ser indexadas (ex.: 404). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = site.ogImage,
  ogImageAlt = site.ogImageAlt,
  noindex = false,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(url(ogImage), Astro.site);
const homeUrl = new URL(url(), Astro.site);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: homeUrl.href,
  image: new URL(url('images/avatar-320.webp'), Astro.site).href,
  sameAs: site.social.map(({ href }) => href),
};
// Escapa `<` para o JSON nunca fechar a tag <script> antes da hora.
const jsonLd = JSON.stringify(personJsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
    >
      Pular para o conteúdo
    </a>
    <Navbar />
    <main id="conteudo" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
