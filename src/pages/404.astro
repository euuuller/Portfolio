---
// Gerada como dist/404.html; o GitHub Pages a serve para qualquer rota inexistente.
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/site';
---

<BaseLayout title="Página não encontrada" noindex>
  <section aria-labelledby="titulo" class="mx-auto max-w-5xl px-5 py-24">
    <p class="font-mono text-sm text-muted">Erro 404</p>
    <h1 id="titulo" class="mt-2 text-4xl font-bold tracking-tight">Página não encontrada</h1>
    <p class="mt-4 text-lg text-muted">O endereço não existe ou foi movido.</p>
    <p class="mt-8">
      <a href={url()} class="rounded-lg bg-accent px-5 py-3 font-medium text-accent-fg hover:opacity-90">
        Voltar para a página inicial
      </a>
    </p>
  </section>
</BaseLayout>
