---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechBadge from '../components/TechBadge.astro';
import { projects } from '../data/projects';
import { site, url } from '../data/site';

const github = site.social.find(({ label }) => label === 'GitHub');
const link = 'wrap-break-word text-accent underline underline-offset-4 hover:no-underline';
---

<BaseLayout title={site.name}>
  <section aria-labelledby="titulo" class="mx-auto max-w-5xl px-5 py-16 sm:py-24">
    <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-2xl">
        <h1 id="titulo" class="text-4xl font-bold tracking-tight text-balance sm:text-5xl">{site.name}</h1>
        <p class="mt-3 text-xl font-medium text-accent">{site.jobTitle}</p>
        <p class="mt-6 text-lg text-muted">
          Graduando em Engenharia Elétrica com atuação em Análise e Ciência de Dados. Construo pipelines de dados,
          modelos preditivos e análises exploratórias com Python, SQL, dbt e Power BI.
        </p>
        <p class="mt-8 flex flex-wrap gap-4">
          <a
            href="#projetos"
            class="rounded-lg bg-accent px-5 py-3 font-medium text-accent-fg hover:opacity-90"
          >
            Ver projetos
          </a>
          {
            site.resumePath && (
              <a
                href={url(site.resumePath)}
                class="rounded-lg border border-border px-5 py-3 font-medium hover:bg-surface"
              >
                Baixar currículo <span class="text-muted">(PDF)</span>
              </a>
            )
          }
        </p>
      </div>
      <!-- Acima da dobra: eager. O LCP medido é a capa do 1º projeto, que recebe fetchpriority.
           Monograma provisório: troque pela foto e preencha site.avatarAlt. -->
      <img
        src={url('images/avatar-160.webp')}
        srcset={`${url('images/avatar-160.webp')} 1x, ${url('images/avatar-320.webp')} 2x`}
        width="160"
        height="160"
        alt={site.avatarAlt}
        loading="eager"
        decoding="async"
        class="size-32 rounded-full sm:size-40"
      />
    </div>
  </section>

  <section id="projetos" aria-labelledby="titulo-projetos" class="mx-auto max-w-5xl px-5 py-16">
    <h2 id="titulo-projetos" class="text-2xl font-bold tracking-tight">Projetos</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, index) => (
          <li class="flex">
            <ProjectCard {...project} priority={index === 0} />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="sobre" aria-labelledby="titulo-sobre" class="mx-auto max-w-5xl px-5 py-16">
    <h2 id="titulo-sobre" class="text-2xl font-bold tracking-tight">Sobre</h2>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Combino o rigor analítico, a modelagem matemática e a visão de sistemas da engenharia com dados para transformar
      informação complexa em <em>insights</em> acionáveis. Meu foco é resolver problemas reais de negócio com estatística
      aplicada e aprendizado de máquina.
    </p>
    <h3 class="mt-10 text-lg font-semibold">Ferramentas</h3>
    <ul class="mt-4 flex max-w-2xl flex-wrap gap-2">
      {
        site.skills.map((label) => (
          <li>
            <TechBadge label={label} />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="contato" aria-labelledby="titulo-contato" class="mx-auto max-w-5xl px-5 py-16">
    <h2 id="titulo-contato" class="text-2xl font-bold tracking-tight">Contato</h2>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Para propostas, oportunidades e conversas técnicas, escreva para <a href={`mailto:${site.email}`} class={link}
        >{site.email}</a
      >.
    </p>
    {
      github && (
        <p class="mt-3 max-w-2xl text-lg text-muted">
          Código e estudos estão no <a href={github.href} class={link}>GitHub</a>.
        </p>
      )
    }
  </section>
</BaseLayout>
